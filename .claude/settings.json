{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(pytest *)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(.venv/bin/pytest *)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git stash)",
      "Bash(git stash -*)",
      "Bash(git stash push *)",
      "Bash(git stash save *)",
      "Bash(git stash pop *)",
      "Bash(git stash apply *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git stash create *)",
      "Bash(git stash store *)",
      "Bash(git stash branch *)",
      "Bash(git tag *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git remote add *)",
      "Bash(git remote remove *)",
      "Bash(git remote rm *)",
      "Bash(git remote rename *)",
      "Bash(git remote set-url *)",
      "Bash(git remote set-head *)",
      "Bash(git remote set-branches *)",
      "Bash(git remote prune *)",
      "Bash(git remote update *)",
      "Bash(git config *)",
      "Bash(git -C *)",
      "Bash(git -c *)",
      "Bash(git --git-dir*)",
      "Bash(git --work-tree*)",
      "Bash(/usr/bin/git *)",
      "Bash(/usr/local/bin/git *)",
      "Bash(/opt/homebrew/bin/git *)",
      "Bash(/Library/Developer/CommandLineTools/usr/bin/git *)",
      "Bash(xcrun git *)",
      "Bash(sh -c *)",
      "Bash(bash -c *)",
      "Bash(zsh -c *)",
      "Bash(eval *)",
      "Bash(env *)",
      "Bash(printenv *)",
      "Bash(security find-generic-password *)",
      "Bash(security find-internet-password *)",
      "Bash(security dump-keychain *)",
      "Bash(security export *)"
    ],
    "deny": [
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * +*)",
      "Bash(git push *--mirror*)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git reflog expire *)",
      "Bash(git reflog delete *)",
      "Bash(git update-ref *)",
      "Bash(git replace *)",
      "Bash(git init *)",
      "Read(**/.claude/settings.local.json)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(.envrc)",
      "Read(.netrc)",
      "Read(secrets/**)",
      "Read(.secrets/**)",
      "Read(*.secret)",
      "Read(*.secrets)",
      "Read(*secret*.json)",
      "Read(*secret*.yaml)",
      "Read(*secret*.yml)",
      "Read(*secret*.toml)",
      "Read(credentials*)",
      "Read(*credentials*.json)",
      "Read(token*.json)",
      "Read(*.token)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(*.jks)",
      "Read(id_rsa*)",
      "Read(id_ecdsa*)",
      "Read(id_ed25519*)",
      "Read(config/local/**)",
      "Read(*.local.yaml)",
      "Read(*.local.yml)",
      "Read(*.local.toml)",
      "Read(*.local.json)",
      "Read(testrail.yaml)",
      "Read(testrail.yml)",
      "Read(testrail.toml)",
      "Read(testrail.json)",
      "Read(testrail.ini)"
    ]
  }
}
